{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.6/.schema/devbox.schema.json",
  "packages": [
    "bundler@latest",
    "ripgrep@latest",
    "ruby@3.4.9"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null",
      "gem install jekyll --version \"~> 4.3.4\""
    ],
    "scripts": {
      "b":  ["bundle exec jekyll serve"],
      "sd": ["bundle exec jekyll serve --drafts --future"],
      "sf": ["bundle exec jekyll serve --future"],
      "s":  ["bundle exec jekyll serve"]
    }
  }
}
